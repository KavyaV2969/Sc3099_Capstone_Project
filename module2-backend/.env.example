# Local (non-Docker) backend run against the Compose database and Redis.
# Values match the docker-compose.yml development defaults; replace them for shared deployments.
SECRET_KEY=saiv-local-development-jwt-secret-change-me-2026

DATABASE_URL=postgresql://backend_app:backend_app_password@127.0.0.1:5434/saiv
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=3600
REFRESH_TOKEN_EXPIRE_SECONDS=604800
REDIS_URL=redis://127.0.0.1:6380/0
CORS_ORIGINS=http://localhost:3000,http://localhost:8501
PUBLIC_FRONTEND_URL=http://localhost:3000
FACE_SERVICE_URL=http://localhost:8001
RETENTION_CLEANUP_ENABLED=true
RETENTION_CLEANUP_INTERVAL_SECONDS=3600
