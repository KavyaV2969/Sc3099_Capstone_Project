# Copy to .env and supply private values. Never commit actual credentials.
# Changing POSTGRES_PASSWORD does not rotate an existing database's password.
POSTGRES_USER=saiv
POSTGRES_DB=saiv
POSTGRES_PASSWORD=YOUR_PRIVATE_OPERATOR_PASSWORD
MIGRATION_DATABASE_URL=postgresql://saiv:YOUR_PRIVATE_OPERATOR_PASSWORD@postgres:5432/saiv
BACKEND_DATABASE_URL=postgresql://backend_app:YOUR_PRIVATE_APPLICATION_PASSWORD@postgres:5432/saiv
DASHBOARD_DATABASE_URL=postgresql://dashboard_reader:YOUR_PRIVATE_READER_PASSWORD@postgres:5432/saiv
# Generate at least 32 random characters; this intentionally invalid placeholder cannot start the app.
SECRET_KEY=REPLACE_ME
PUBLIC_BACKEND_URL=http://localhost:8000/api/v1
PUBLIC_FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8501
FACE_SERVICE_URL=http://face-recognition:8001
# Set only to reuse an existing Redis data volume; otherwise the named default is created.
# REDIS_VOLUME_NAME=existing-volume-name
