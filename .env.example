# Optional. docker-compose.yml already contains working local-development defaults,
# so a clean clone starts with `docker-compose up -d` and no .env file.
# For any shared deployment, copy to .env and replace every password and the secret.
# Changing POSTGRES_PASSWORD does not rotate an existing database's password.
POSTGRES_USER=saiv
POSTGRES_DB=saiv
POSTGRES_PASSWORD=saiv_password
MIGRATION_DATABASE_URL=postgresql://saiv:saiv_password@postgres:5432/saiv
BACKEND_DATABASE_URL=postgresql://backend_app:backend_app_password@postgres:5432/saiv
DASHBOARD_DATABASE_URL=postgresql://dashboard_reader:dashboard_reader_password@postgres:5432/saiv
# At least 32 characters. Generate a fresh random value for any shared deployment.
SECRET_KEY=saiv-local-development-jwt-secret-change-me-2026
PUBLIC_BACKEND_URL=http://localhost:8000/api/v1
PUBLIC_FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8501
FACE_SERVICE_URL=http://face-recognition:8001
# Set only to reuse an existing Redis data volume; otherwise the named default is created.
# REDIS_VOLUME_NAME=existing-volume-name
